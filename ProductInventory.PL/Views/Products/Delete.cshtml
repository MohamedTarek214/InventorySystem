@model ProductViewModel
@{
    ViewData["Title"] = "Delete product";
}

<h1 class="h3 mb-3">Delete product</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this product? It will be deactivated and hidden from the product list.
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.SKU)</dt>
    <dd class="col-sm-9"><code>@Model.SKU</code></dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.StockQuantity)</dt>
    <dd class="col-sm-9">@Model.StockQuantity</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
