@model ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Products</h1>
    <a asp-action="Create" class="btn btn-primary">Add product</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-5">
        <input asp-for="Search" class="form-control" placeholder="Search by name or SKU" />
    </div>
    <div class="col-md-3">
        <select asp-for="Category" asp-items="CategorySelectList.Items" class="form-select">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@if (!Model.Products.Any())
{
    <div class="alert alert-info">No products found. Try a different search or add a new product.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Stock</th>
                    <th>Expiry date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td><code>@product.SKU</code></td>
                        <td>@product.Category</td>
                        <td class="text-end">@product.Price.ToString("N2")</td>
                        <td class="text-end">
                            <span class="badge @(product.IsLowStock ? "bg-danger" : "bg-secondary")">@product.StockQuantity</span>
                        </td>
                        <td>@(product.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Restock" asp-route-id="@product.Id" class="btn btn-sm btn-outline-success">Restock</a>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted">Showing page @Model.Page of @Model.TotalPages (@Model.TotalCount products)</p>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Pagination">
            <ul class="pagination">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                       asp-route-search="@Model.Search" asp-route-category="@Model.Category">Previous</a>
                </li>
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i"
                           asp-route-search="@Model.Search" asp-route-category="@Model.Category">@i</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                       asp-route-search="@Model.Search" asp-route-category="@Model.Category">Next</a>
                </li>
            </ul>
        </nav>
    }
}
